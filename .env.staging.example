# Copy this file to .env.staging, set fresh secrets, then run `npm run start:staging`.
# Keep .env.staging private; it is intentionally ignored by Git.

# Use `staging` for local HTTP so the admin cookie is not forced to Secure.
# Set `production` only when this instance is behind HTTPS.
NODE_ENV=staging
PORT=3100
DATA_DIR=./data-staging
BACKUP_DIR=./backups-staging
BACKUP_RETENTION=14
# Create a backup on startup, then every 24 hours. Set 0 to disable automatic backups.
BACKUP_INTERVAL_HOURS=24
CHAT_RETENTION_DAYS=30

# Use a long random secret. Do not reuse a development token.
ADMIN_TOKEN=replace-with-a-long-random-secret
ADMIN_PATH=/moderation-replace-with-a-random-path
ADMIN_SESSION_TTL_HOURS=8
# False is correct only for a local HTTP staging check. Use true behind HTTPS.
ADMIN_COOKIE_SECURE=false
TRUST_PROXY=false

# Optional for a single Node instance; leave empty unless Redis is configured separately.
REDIS_URL=
