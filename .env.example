# Copy to .env and adjust as needed. Do not commit your real .env.

# HTTP and Socket.IO port.
PORT=3000

# Directory for durable report, ban, and chat transcript records.
DATA_DIR=./data

# Directory for timestamped JSON snapshots created by `npm run backup`.
BACKUP_DIR=./backups

# Number of snapshots to retain automatically. Set to 0 to keep all snapshots.
BACKUP_RETENTION=14

# Automatic backup interval in hours. Set to 0 to disable; staging uses 24.
BACKUP_INTERVAL_HOURS=0

# Completed chat transcripts are removed after this many days. Set to 0 to retain indefinitely.
CHAT_RETENTION_DAYS=30

# Secret that protects the moderation dashboard and API.
# Use this long, random value to bootstrap the first named admin account and for emergency access.
# After setup, named accounts can sign in without sharing this token.
ADMIN_TOKEN=

# Lifetime of the in-memory browser admin session after sign-in.
ADMIN_SESSION_TTL_HOURS=8

# Optional: force the Secure flag on the admin session cookie.
# ADMIN_COOKIE_SECURE=true

# Named moderator accounts are stored as password hashes in DATA_DIR/moderators.json.
# The file is created from the Team tab after signing in with ADMIN_TOKEN.

# Secret URL path for the moderation dashboard. Keep the default only for local development.
ADMIN_PATH=/admin

# Optional: enable the Socket.IO Redis adapter for multi-instance deployments.
# Example: redis://localhost:6379
REDIS_URL=

# Optional Web Push settings. If omitted, the server generates and stores a private key file
# at DATA_DIR/.push-vapid.keys (back it up separately; it is not included in JSON snapshots).
PUSH_VAPID_SUBJECT=mailto:admin@ghostchat.local
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
