# Copy to .env and adjust as needed. Do not commit your real .env.

# HTTP and Socket.IO port.
PORT=3000

# Directory for durable report, ban, and chat transcript records.
DATA_DIR=./data

# Completed chat transcripts are removed after this many days. Set to 0 to retain indefinitely.
CHAT_RETENTION_DAYS=30

# Secret that protects the moderation dashboard and API.
# Leave empty to disable admin access. Use a long, random value in production.
ADMIN_TOKEN=

# Secret URL path for the moderation dashboard. Keep the default only for local development.
ADMIN_PATH=/admin

# Optional: enable the Socket.IO Redis adapter for multi-instance deployments.
# Example: redis://localhost:6379
REDIS_URL=
